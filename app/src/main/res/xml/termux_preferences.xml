<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <Preference
        app:title="@string/termux_debugging_preferences_title"
        app:summary="@string/termux_debugging_preferences_summary"
        app:fragment="com.termux.app.fragments.settings.termux.DebuggingPreferencesFragment"/>

    <Preference
        app:title="@string/termux_terminal_io_preferences_title"
        app:summary="@string/termux_terminal_io_preferences_summary"
        app:fragment="com.termux.app.fragments.settings.termux.TerminalIOPreferencesFragment"/>

    <Preference
        app:title="@string/termux_terminal_view_preferences_title"
        app:summary="@string/termux_terminal_view_preferences_summary"
        app:fragment="com.termux.app.fragments.settings.termux.TerminalViewPreferencesFragment"/>


    <SwitchPreference
        app:key="volume_keys_behaviour"
        app:title="Кнопки громкости = extra keys"
        app:summary="Выключи, чтобы кнопки громкости регулировали звук"
        app:defaultValue="true" />


    <SwitchPreference
        app:key="show_paste_key"
        app:title="Показывать кнопку «Вставить» (Pst)"
        app:defaultValue="true" />
    <SwitchPreference
        app:key="show_copy_all_key"
        app:title="Показывать кнопку «Копировать всё» (Cp_All)"
        app:defaultValue="true" />
    <SwitchPreference
        app:key="show_clear_paste_key"
        app:title="Показывать кнопку «Очистить и вставить» (Pst_Clr)"
        app:defaultValue="true" />


    <SwitchPreference
        app:key="use_short_names"
        app:title="Сокращённые названия кнопок"
        app:summary="PST вместо PASTE, CP_ALL вместо COPY_ALL"
        app:defaultValue="true" />

    <SwitchPreference
        app:key="use_short_names"
        app:title="Сокращённые названия кнопок"
        app:summary="Pst вместо PASTE, Cp_All вместо COPY_ALL"
        app:defaultValue="true" />
    <SwitchPreference
        app:key="show_arrows"
        app:title="Показывать стрелки (UP/DOWN/LEFT/RIGHT)"
        app:defaultValue="false" />
    <SwitchPreference
        app:key="show_tab_home_end"
        app:title="Показывать TAB, HOME, END"
        app:defaultValue="false" />
</PreferenceScreen>
